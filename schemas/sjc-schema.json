{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "SJCRecord",
    "type": "object",
    "properties": {
        "fetched_at": { "type": "string", "format": "date-time" },
        "latestDate": { "type": "string" },
        "Id": { "type": "integer" },
        "TypeName": { "type": "string" },
        "BranchName": { "type": "string" },
        "Buy": { "type": "string" },
        "BuyValue": { "type": "number" },
        "Sell": { "type": "string" },
        "SellValue": { "type": "number" },
        "BuyDiffer": { "type": ["string", "null"] },
        "BuyDifferValue": { "type": "number" },
        "SellDiffer": { "type": ["string", "null"] },
        "SellDifferValue": { "type": "number" },
        "GroupDate": { "type": "string" }
    },
    "required": ["fetched_at", "Id", "TypeName", "BranchName", "BuyValue", "SellValue"]
}